# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# Виняток: без цього jar-а gradlew не стартує взагалі, і свіжий клон репозиторію
# неможливо зібрати з командного рядка. Wrapper для того й існує, щоб збірка не
# вимагала заздалегідь встановленого Gradle — тримати його поза репо безглуздо.
!gradle/wrapper/gradle-wrapper.jar
!main/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Звіти про падіння. Лежать у домашній теці (~/LostBatalion/crash-*.txt), але
# стара версія лаунчера писала їх відносним шляхом, тобто в main/assets/ —
# звідти вони потрапляли в assets.txt, у зібраний jar і в репозиторій.
desktop_crash.txt
crash-*.txt

# Кладе сама гра в робочу теку процесу (див. SteamBoot). При запуску через
# Gradle робоча тека — main/assets/, тож файл опиняється серед асетів.
steam_appid.txt
